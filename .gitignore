*.psd
.DS_Store
*.swp
*.dmg
.vscode/
temp/

# Build artifacts (regenerated by CI / `make`)
/site/
/pdf/
/output/
misc/output/
slides/output/
# Computer-lab notebooks are pulled from the water-course/tutorials repo at build time
docs/computer-lab/

# Year-specific teaching admin (grading, class reports, per-cohort notes).
# Kept on disk but out of the repo; the frozen state lives in the emsc3025-2025 tag.
/admin/

# Worked assignment solutions. This repository is public, so these stay on disk
# only and are built locally with `make -C assignment-solutions`.
/assignment-solutions/

# Private working notes -- not for the repo
/NOTES/
/slides/notes/

# Quarkdown preview/build scratch output
/slides/quarkdown-output/

# Python virtualenv
.venv/

# mkdocs-material build cache
.cache/

# Exam model answers. These must never reach the public site or the public repo.
# The slides Makefile also excludes *_solutions.qd from the build.
/slides/exams/final_exam_solutions.qd
