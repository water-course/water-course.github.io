.function {ul}
    input:
    .text {.input} decoration:{underline} color:{.accent}

.function {emph}
    input:
    .text {.input} color:{.accent}

.function {term}
    input:
    .text {.input} color:{.accent}

.function {answer}
    input:
    .text {.input} size:{larger} decoration:{underline} color:{.accent}

.var {accent}
    rgb(180, 60, 60)

.var {lightblue}
    rgb(173, 216, 230)

.var {lightred}
    rgb(220, 150, 150)

.var {lightgreen}
    rgb(200, 225, 200)

.numbering
  - tables: 1
  - figures: 1
  - headings:

<!--
Never let a table break across a page. The paged renderer does not split a
straddling table, it silently DROPS the rows that do not fit and leaves the
caption orphaned on the next page -- Assignment I lost the second row of its
month table that way, with no warning from the build at all.

The rule below is nested inside the page margin on purpose. Quarkdown emits .css
as a style element in the document flow, and at top level that element sits ahead
of the first heading, whose forced page break then leaves an empty first page.
Page margins are out of flow, so the style rides along invisibly. Keep this
comment outside the block: text inside a pagemargin is printed verbatim, HTML
comment markers and all.
-->

.pagemargin{bottomright}
  .currentpage / .totalpages
  .css
    .quarkdown table { break-inside: avoid; }
