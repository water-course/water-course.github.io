.function {ul}
    input:
    .text {.input} decoration:{underline} color:{.accent}

.function {emph}
    input:
    .text {.input} color:{.accent}

.function {term}
    input:
    .text {.input} color:{.accent}

.function {answer}
    input:
    .text {.input} size:{larger} decoration:{underline} color:{.accent}

.var {accent}
    rgb(180, 60, 60)

.var {lightblue}
    rgb(173, 216, 230)

.var {lightred}
    rgb(220, 150, 150)

.var {lightgreen}
    rgb(200, 225, 200)

.numbering
  - tables: 1
  - figures: 1
  - headings:

.pagemargin{bottomright}
  .currentpage / .totalpages
